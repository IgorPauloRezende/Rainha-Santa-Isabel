# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port where the Express server listens (default: 3000).
PORT=3000

# ADMIN_PASSWORD: Password for accessing the Pastoral Admin Dashboard.
# Change this before deploying to production (Render, Railway, Fly.io, VPS).
ADMIN_PASSWORD="replace-with-a-unique-strong-password"

# SESSION_SECRET: Random secret used to sign admin session cookies.
SESSION_SECRET="replace-with-a-long-random-secret"

# DATA_FILE: Path to the persistent JSON database file (mount a volume here when hosting).
DATA_FILE="./backend/data/church.json"
